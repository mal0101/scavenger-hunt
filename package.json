    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
