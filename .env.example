# ── Database ──────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/scavenger_hunt?sslmode=require"

# ── Redis ─────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ── Auth ──────────────────────────────
JWT_SECRET="CHANGE_ME_generate_a_64_char_random_string_using_openssl_rand_hex_32"
JWT_REFRESH_SECRET="CHANGE_ME_generate_another_64_char_random_string"
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ── QR Code ───────────────────────────
HMAC_SECRET="CHANGE_ME_generate_a_64_char_random_string_for_qr_signing"

# ── SMS / Twilio (optional — mock mode when OTP_MOCK=true) ──
OTP_MOCK="true"
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# ── App ───────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
